---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsSiteSettings } from '../../lib/data';

interface Props {
  settings?: CmsSiteSettings | null;
}

const { settings: site } = Astro.props;
const footerLinks = (site?.footerLinks?.filter(Boolean) as Array<{ label: string; url: string }> | undefined) ?? [];
const locationLine = site?.locationLine ?? 'Located in Travelers Rest, SC. Serving the Greenville Area — and anywhere your business is located.';
const year = new Date().getFullYear();
---

<footer class="footer topo-bg">
  <div class="footer-inner container">
    <div class="footer-top">
      <a href="/" class="footer-logo" aria-label="Contour — Home">
        <svg
          class="footer-mark"
          width="26"
          height="26"
          viewBox="0 0 32 32"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M26.825 22.25 A12.5 12.5 0 1 1 26.825 9.75"
            stroke-width="2.4"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M22.062 19.5 A7 7 0 1 1 22.062 12.5"
            stroke-width="2.4"
            stroke-linecap="round"
            fill="none"
          />
        </svg>
        <span class="footer-wordmark">Contour<span class="footer-dot">.</span></span>
      </a>

      {footerLinks.length > 0 && (
        <nav aria-label="Footer navigation">
          <ul class="footer-links" role="list" data-tina-field={site ? tinaField(site, 'footerLinks') : undefined}>
            {footerLinks.map((link: { label: string; url: string }) => (
              <li>
                <a href={link.url} class="footer-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    <p class="footer-location" data-tina-field={site ? tinaField(site, 'locationLine') : undefined}>{locationLine}</p>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; {year} Contour. All rights reserved.</p>
      <ul class="footer-legal" role="list">
        <li><a href="/privacy" class="footer-legal-link">Privacy Policy</a></li>
        <li><a href="/terms" class="footer-legal-link">Terms</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 3rem var(--container-padding) 2rem;
    border-top: 1px solid var(--border-on-dark-strong);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .footer-top {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .footer-mark path {
    stroke: var(--teal);
  }

  .footer-wordmark {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--text-on-dark);
    letter-spacing: -0.01em;
  }

  .footer-dot {
    color: var(--teal);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-link {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--text-on-dark);
    opacity: 0.75;
    text-decoration: none;
    transition: opacity var(--transition) var(--ease);
  }

  .footer-link:hover {
    opacity: 1;
    color: var(--text-on-dark);
  }

  .footer-location {
    font-size: 0.875rem;
    color: var(--text-on-dark);
    opacity: 0.6;
    line-height: 1.5;
    white-space: pre-line;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-on-dark-hairline);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-copy {
    font-size: 0.8125rem;
    color: var(--text-on-dark);
    opacity: 0.5;
  }

  .footer-legal {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-legal-link {
    font-size: 0.8125rem;
    color: var(--text-on-dark);
    opacity: 0.5;
    text-decoration: none;
    transition: opacity var(--transition) var(--ease);
  }

  .footer-legal-link:hover {
    opacity: 0.8;
    color: var(--text-on-dark);
  }
</style>
