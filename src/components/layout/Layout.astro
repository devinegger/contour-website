---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import '../../styles/global.css';
import { getSiteSettings } from '../../lib/data';
import { islands } from '../../lib/islands';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  schemas?: object[];
}

const settings = await getSiteSettings();
const site = settings?.data?.siteSettings;
const {
  title = site?.defaultSeoTitle ?? 'Contour',
  description = site?.defaultSeoDescription ?? '',
  ogImage = site?.defaultOgImage ?? '',
  schemas = [],
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="website" />
    <title>{title}</title>
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/dm-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <TinaIsland name="nav" wrapper={islands.nav.wrapper}>
      <Nav settings={site} />
    </TinaIsland>
    <main id="main-content">
      <slot />
    </main>
    <TinaIsland name="footer" wrapper={islands.footer.wrapper}>
      <Footer settings={site} />
    </TinaIsland>
  </body>
</html>
