---
interface CardData {
  headline: string;
  description?: string;
  price?: string;
  ctaLabel?: string;
  ctaUrl?: string;
}

interface Props {
  card1?: CardData;
  card2?: CardData;
}

const { card1, card2 } = Astro.props;
const cards = [card1, card2].filter(Boolean) as CardData[];
---

<section class="secondary-svcs topo-bg-light">
  <div class="container secondary-section">
    <div class="secondary-grid">
      {cards.map((card: CardData) => (
        <article class="secondary-card">
          <h3 class="card-headline">{card.headline}</h3>
          {card.description && <p class="card-desc">{card.description}</p>}
          {card.price && <p class="card-price">{card.price}</p>}
          {card.ctaLabel && card.ctaUrl && (
            <a href={card.ctaUrl} class="btn btn-secondary btn-sm card-cta">
              {card.ctaLabel}
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .secondary-section {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .secondary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 700px) {
    .secondary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .secondary-card {
    background: var(--surface-card-light);
    border: 1px solid var(--border-on-dark);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color var(--transition) var(--ease);
  }

  .secondary-card:hover {
    border-color: var(--border-on-dark-strong);
  }

  .card-headline {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    color: var(--text-on-light);
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.9375rem;
    color: var(--text-on-light-muted);
    line-height: 1.55;
    flex: 1;
  }

  .card-price {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: var(--fw-heading);
    color: var(--text-on-light);
  }

  .card-cta {
    align-self: flex-start;
    margin-top: 0.25rem;
  }
</style>
