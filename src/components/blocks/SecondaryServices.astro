---
interface CardData {
  headline: string;
  description?: string;
  price?: string;
  ctaLabel?: string;
  ctaUrl?: string;
}

interface Props {
  card1?: CardData;
  card2?: CardData;
}

const { card1, card2 } = Astro.props;
const cards = [card1, card2].filter(Boolean) as CardData[];
---

<section class="secondary-svcs surface-light">
  <div class="container section">
    <div class="secondary-grid">
      {cards.map((card: CardData) => (
        <article class="secondary-card">
          <h3 class="card-headline">{card.headline}</h3>
          {card.description && <p class="card-desc">{card.description}</p>}
          {card.price && <p class="card-price">{card.price}</p>}
          {card.ctaLabel && card.ctaUrl && (
            <a href={card.ctaUrl} class="btn btn-secondary card-cta">
              {card.ctaLabel}
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .secondary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .secondary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .secondary-card {
    background: white;
    border: 2px solid rgba(74, 140, 140, 0.2);
    border-radius: 8px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s;
  }

  .secondary-card:hover {
    border-color: var(--color-accent);
  }

  .card-headline {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    color: var(--color-text-dark);
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.9375rem;
    color: var(--color-text-dark);
    opacity: 0.75;
    line-height: 1.55;
    flex: 1;
  }

  .card-price {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-dark);
  }

  .card-cta {
    align-self: flex-start;
    margin-top: 0.25rem;
  }
</style>
