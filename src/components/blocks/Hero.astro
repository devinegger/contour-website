---
interface Props {
  headline: string;
  subheading?: string;
  primaryCtaLabel?: string;
  primaryCtaUrl?: string;
  secondaryCtaLabel?: string;
  secondaryCtaUrl?: string;
  trustAnchor?: string;
  eyebrow?: string;
  tinaField?: (obj: unknown, field: string) => string;
  data?: unknown;
}

const {
  headline,
  subheading,
  primaryCtaLabel,
  primaryCtaUrl,
  secondaryCtaLabel,
  secondaryCtaUrl,
  trustAnchor,
  eyebrow = 'Web design & local marketing',
} = Astro.props;
---

<section class="hero topo-bg">
  <div class="hero-inner container">
    <div class="hero-content">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="hero-headline">{headline}</h1>
      {subheading && <p class="hero-subheading">{subheading}</p>}
      <div class="hero-ctas">
        {primaryCtaLabel && primaryCtaUrl && (
          <a href={primaryCtaUrl} class="btn btn-primary btn-lg">{primaryCtaLabel}</a>
        )}
        {secondaryCtaLabel && secondaryCtaUrl && (
          <a href={secondaryCtaUrl} class="btn btn-secondary btn-lg">{secondaryCtaLabel}</a>
        )}
      </div>
      {trustAnchor && <p class="hero-trust">{trustAnchor}</p>}
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(5rem, 13vw, 9rem) var(--container-padding);
    min-height: 78vh;
    display: flex;
    align-items: center;
  }

  .hero-inner {
    width: 100%;
  }

  .hero-content {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-headline {
    font-family: var(--font-heading);
    font-size: var(--fs-display);
    font-weight: var(--fw-display);
    color: var(--text-on-dark);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .hero-subheading {
    font-family: var(--font-body);
    font-size: var(--fs-body-lg);
    font-weight: var(--fw-body);
    color: var(--text-on-dark);
    opacity: 0.82;
    line-height: 1.55;
    max-width: 58ch;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 0.5rem;
  }

  .hero-trust {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--text-on-dark);
    opacity: 0.55;
    margin-top: 0.25rem;
  }
</style>
