---
interface Props {
  image?: string;
  alt?: string;
  caption?: string;
  width?: 'contained' | 'full-bleed';
  background?: 'light' | 'dark';
}

const { image, alt, caption, width = 'contained', background = 'light' } = Astro.props;
const isDark = background === 'dark';
const isFullBleed = width === 'full-bleed';
---

<section class={`image-block ${isDark ? 'surface-dark' : 'surface-light'}`}>
  <div class={isFullBleed ? '' : 'container section'}>
    {image && (
      <figure class={isFullBleed ? 'image-figure--full' : 'image-figure'}>
        <img src={image} alt={alt ?? ''} loading="lazy" class={isFullBleed ? '' : 'image-figure-img'} />
        {caption && <figcaption class="image-caption">{caption}</figcaption>}
      </figure>
    )}
  </div>
</section>

<style>
  .image-figure {
    margin: 0;
  }

  .image-figure-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  .image-figure--full {
    margin: 0;
  }

  .image-figure--full img {
    display: block;
    width: 100%;
    height: auto;
  }

  .image-caption {
    margin-top: var(--space-3);
    text-align: center;
    font-size: var(--fs-caption);
    opacity: 0.7;
  }

  .image-figure--full .image-caption {
    padding-inline: var(--container-padding);
    margin-top: var(--space-3);
  }
</style>
