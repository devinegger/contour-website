---
import Prose from '../Prose.astro';
import { cfImage, cfSrcset } from '../../lib/image';

interface FeatureItem {
  title?: string;
  titleAlign?: 'left' | 'center' | 'right';
  url?: string;
  image?: string;
  richBody?: unknown;
}

interface Props {
  headline?: string;
  richIntro?: unknown;
  items?: (FeatureItem | null)[];
  background?: 'light' | 'dark';
}

const { headline, richIntro, items = [], background = 'light' } = Astro.props;
const isDark = background === 'dark';
const features = (items ?? []).filter((item): item is FeatureItem => Boolean(item));
---

<section class={`features ${isDark ? 'surface-dark' : 'surface-light'}`}>
  <div class="container section">
    {(headline || richIntro) && (
      <div class="features-header">
        {headline && <h2 class="features-headline">{headline}</h2>}
        {richIntro && (
          <div class="prose features-intro">
            <Prose content={richIntro} />
          </div>
        )}
      </div>
    )}
    <div class="features-grid">
      {features.map((item) => (
        <div class="feature-item">
          {item.title && (
            <h3 class="feature-title" style={`text-align: ${item.titleAlign ?? 'left'};`}>
              {item.url ? (
                <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a>
              ) : (
                item.title
              )}
            </h3>
          )}
          {item.image && (
            item.url ? (
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="feature-media">
                <img
                  src={cfImage(item.image, { width: 800 })}
                  srcset={cfSrcset(item.image, 800)}
                  alt={item.title ?? ''}
                  loading="lazy"
                />
              </a>
            ) : (
              <img
                class="feature-media"
                src={cfImage(item.image, { width: 800 })}
                srcset={cfSrcset(item.image, 800)}
                alt={item.title ?? ''}
                loading="lazy"
              />
            )
          )}
          {item.richBody && (
            <div class="prose feature-body">
              <Prose content={item.richBody} />
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-header {
    text-align: center;
    max-width: var(--measure);
    margin-inline: auto;
    margin-bottom: var(--space-7);
  }

  .features-headline {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    font-weight: var(--fw-heading);
    line-height: var(--lh-heading);
  }

  .features-intro {
    margin-top: var(--space-3);
    font-size: 1.0625rem;
    opacity: 0.85;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 700px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .feature-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    font-weight: var(--fw-heading);
  }

  .feature-title a {
    color: inherit;
    text-decoration: none;
  }

  .feature-title a:hover {
    text-decoration: underline;
  }

  .feature-media {
    display: block;
    width: 100%;
  }

  .feature-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  .feature-body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    opacity: 0.85;
  }
</style>
