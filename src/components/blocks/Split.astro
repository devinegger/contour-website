---
import Prose from '../Prose.astro';
import { cfImage, cfSrcset } from '../../lib/image';

interface Props {
  headline?: string;
  body?: unknown;
  image?: string;
  imageAlt?: string;
  imagePosition?: 'left' | 'right';
  ctaLabel?: string;
  ctaUrl?: string;
  background?: 'light' | 'dark';
}

const {
  headline,
  body,
  image,
  imageAlt,
  imagePosition = 'left',
  ctaLabel,
  ctaUrl,
  background = 'light',
} = Astro.props;

const isDark = background === 'dark';
const imageFirst = imagePosition !== 'right';

// The split image fills ~half the container; request an 800px-wide variant.
const imageSrc = cfImage(image, { width: 800 });
const imageSrcset = cfSrcset(image, 800);
---

<section class={`split ${isDark ? 'surface-dark' : 'surface-light'}`}>
  <div class="container section split-grid">
    <div class={`split-media ${imageFirst ? '' : 'split-media--second'}`}>
      {image && <img src={imageSrc} srcset={imageSrcset} alt={imageAlt ?? ''} loading="lazy" />}
    </div>
    <div class={`split-content ${imageFirst ? '' : 'split-content--first'}`}>
      {headline && <h2 class="split-headline">{headline}</h2>}
      {body && (
        <div class="prose split-body">
          <Prose content={body} />
        </div>
      )}
      {ctaLabel && ctaUrl && (
        <a href={ctaUrl} class={`btn btn-lg ${isDark ? 'btn-primary' : 'btn-secondary'}`}>
          {ctaLabel}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .split-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--space-7);
  }

  @media (min-width: 800px) {
    .split-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-9);
    }

    .split-media--second {
      order: 2;
    }

    .split-content--first {
      order: 1;
    }
  }

  .split-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .split-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .split-headline {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    font-weight: var(--fw-heading);
    line-height: var(--lh-heading);
  }

  .split-body {
    font-size: 1.0625rem;
    opacity: 0.85;
  }
</style>
