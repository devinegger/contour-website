---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';

interface Props {
  opening?: string;
  storyBody?: unknown;
  howWeWork?: unknown;
  locationLine?: string;
  ctaLabel?: string;
  ctaUrl?: string;
}

const { opening, storyBody, howWeWork, locationLine, ctaLabel, ctaUrl } = Astro.props;
---

<section class="about-story surface-light">
  <div class="container section">
    <div class="story-content">
      {opening && (
        <div class="story-lede">
          <p class="eyebrow">About Contour</p>
          <p class="story-opening">{opening}</p>
        </div>
      )}

      {storyBody && (
        <div class="story-section prose">
          <TinaMarkdown content={storyBody} />
        </div>
      )}

      <hr class="divider" />

      {howWeWork && (
        <div class="story-section prose">
          <h2 class="story-subhead">How we work</h2>
          <TinaMarkdown content={howWeWork} />
        </div>
      )}

      {locationLine && (
        <p class="story-location">{locationLine}</p>
      )}

      {ctaLabel && ctaUrl && (
        <div class="story-cta-wrap">
          <a href={ctaUrl} class="btn btn-primary">{ctaLabel}</a>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .story-content {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .story-content > .divider {
    margin-block: 0;
  }

  .story-lede {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .story-opening {
    font-family: var(--font-heading);
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    font-weight: var(--fw-ui);
    color: var(--text-on-light);
    line-height: 1.4;
  }

  .story-section {
    color: var(--text-on-light);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .story-subhead {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--text-on-light);
    margin-bottom: 1rem;
  }

  .story-location {
    font-style: italic;
    color: var(--text-on-light-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .story-cta-wrap {
    padding-top: 0.5rem;
  }
</style>
