---
import { getServices } from '../../lib/data';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';

const servicesResult = await getServices();
const allServices = servicesResult?.data?.servicesConnection?.edges ?? [];
const services = allServices.map((e: { node: unknown }) => e.node) as Array<{
  name: string;
  slug: string;
  tier: string;
  tagline?: string;
  description?: unknown;
  price?: string;
  setupFee?: string;
  inclusions?: string[];
  ctaLabel?: string;
  ctaUrl?: string;
}>;

const primaryTiers = ['baseline', 'elevated', 'crest'];
const secondaryTiers = ['wp-migration', 'custom-build'];
const featuredTier = 'elevated';

const primary = services
  .filter(s => primaryTiers.includes(s.tier))
  .sort((a, b) => primaryTiers.indexOf(a.tier) - primaryTiers.indexOf(b.tier));
const secondary = services.filter(s => secondaryTiers.includes(s.tier));
---

<section class="services-full surface-light">
  <div class="container section">
    <div class="primary-services">
      {primary.map(service => {
        const featured = service.tier === featuredTier;
        const showTier = service.tier?.toLowerCase() !== service.name?.toLowerCase();
        return (
          <article class={`service-card ${featured ? 'service-card--featured' : ''}`}>
            <div class="service-card-header">
              {(showTier || featured) && (
                <div class="service-tier-row">
                  {showTier && <span class="service-tier">{service.tier}</span>}
                  {featured && <span class="service-popular">Most popular</span>}
                </div>
              )}
              <h3 class="service-name">{service.name}</h3>
              {service.tagline && <p class="service-tagline">{service.tagline}</p>}
            </div>
            <div class="service-pricing">
              {service.price && <span class="service-price">{service.price}</span>}
              {service.setupFee && <span class="service-setup">+ {service.setupFee} setup</span>}
            </div>
            {service.description && (
              <div class="service-desc prose">
                <TinaMarkdown content={service.description} />
              </div>
            )}
            {service.inclusions && service.inclusions.length > 0 && (
              <ul class="service-inclusions" role="list">
                {service.inclusions.map((item: string) => (
                  <li class="inclusion-item">
                    <svg class="inclusion-check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3 8.5L6.5 12L13 4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            )}
            {service.ctaLabel && service.ctaUrl && (
              <a href={service.ctaUrl} class={`btn ${featured ? 'btn-light' : 'btn-primary'} service-cta`}>
                {service.ctaLabel}
              </a>
            )}
          </article>
        );
      })}
    </div>

    {secondary.length > 0 && (
      <div class="secondary-services-section">
        <h2 class="secondary-heading">One-time & migration options</h2>
        <div class="secondary-grid">
          {secondary.map(service => (
            <article class="secondary-card">
              <span class="service-tier">{service.tier}</span>
              <h3 class="service-name">{service.name}</h3>
              {service.tagline && <p class="service-tagline">{service.tagline}</p>}
              <p class="service-price">{service.price}</p>
              {service.ctaLabel && service.ctaUrl && (
                <a href={service.ctaUrl} class="btn btn-secondary btn-sm secondary-cta">
                  {service.ctaLabel}
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .primary-services {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
    margin-bottom: 4rem;
  }

  @media (min-width: 800px) {
    .primary-services {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    background: var(--surface-card-light);
    border: 1px solid var(--border-on-light);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  /* Featured card — Teal Dim, used to single out one option */
  .service-card--featured {
    background: var(--surface-featured);
    border-color: color-mix(in srgb, var(--teal-light) 45%, transparent);
  }

  .service-card-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .service-tier-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .service-tier {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    color: var(--accent);
    line-height: 1;
  }

  .service-card--featured .service-tier {
    color: var(--stone);
  }

  .service-popular {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stone);
    opacity: 0.7;
  }

  .service-name {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--text-on-light);
  }

  .service-card--featured .service-name {
    color: var(--stone);
  }

  .service-tagline {
    font-size: 0.9375rem;
    color: var(--text-on-light-muted);
    line-height: 1.5;
    white-space: pre-line;
  }

  .service-card--featured .service-tagline {
    color: color-mix(in srgb, var(--stone) 82%, transparent);
  }

  .service-pricing {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .service-price {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: var(--fw-display);
    color: var(--text-on-light);
  }

  .service-card--featured .service-price {
    color: var(--stone);
  }

  .service-setup {
    font-size: 0.875rem;
    color: var(--text-on-light-muted);
  }

  .service-card--featured .service-setup {
    color: color-mix(in srgb, var(--stone) 70%, transparent);
  }

  .service-desc {
    color: var(--text-on-light);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .service-card--featured .service-desc {
    color: color-mix(in srgb, var(--stone) 85%, transparent);
  }

  .service-inclusions {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }

  .inclusion-item {
    display: flex;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--text-on-light);
    line-height: 1.4;
  }

  .service-card--featured .inclusion-item {
    color: color-mix(in srgb, var(--stone) 90%, transparent);
  }

  .inclusion-check {
    flex-shrink: 0;
    margin-top: 3px;
  }

  .inclusion-check path {
    stroke: var(--accent);
  }

  .service-card--featured .inclusion-check path {
    stroke: var(--stone);
  }

  .service-cta {
    align-self: flex-start;
    margin-top: auto;
  }

  .secondary-services-section {
    border-top: 1px solid var(--border-on-light);
    padding-top: 3rem;
  }

  .secondary-heading {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    color: var(--text-on-light);
    margin-bottom: 1.5rem;
  }

  .secondary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 700px) {
    .secondary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .secondary-card {
    background: var(--surface-card-light);
    border: 1px solid var(--border-on-light);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .secondary-cta {
    align-self: flex-start;
    margin-top: 0.5rem;
  }
</style>
