---
import { getServices } from '../../lib/data';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';

const servicesResult = await getServices();
const allServices = servicesResult?.data?.servicesConnection?.edges ?? [];
const services = allServices.map((e: { node: unknown }) => e.node) as Array<{
  name: string;
  slug: string;
  tier: string;
  tagline?: string;
  description?: unknown;
  price?: string;
  setupFee?: string;
  inclusions?: string[];
  ctaLabel?: string;
  ctaUrl?: string;
}>;

const primaryTiers = ['baseline', 'elevated', 'crest'];
const secondaryTiers = ['wp-migration', 'custom-build'];

const primary = services.filter(s => primaryTiers.includes(s.tier));
const secondary = services.filter(s => secondaryTiers.includes(s.tier));
---

<section class="services-full surface-light">
  <div class="container section">
    <div class="primary-services">
      {primary.map(service => (
        <article class="service-card">
          <div class="service-card-header">
            <span class="service-tier">{service.tier}</span>
            <h3 class="service-name">{service.name}</h3>
            {service.tagline && <p class="service-tagline">{service.tagline}</p>}
          </div>
          <div class="service-pricing">
            {service.price && <span class="service-price">{service.price}</span>}
            {service.setupFee && <span class="service-setup">+ {service.setupFee} setup</span>}
          </div>
          {service.description && (
            <div class="service-desc prose">
              <TinaMarkdown content={service.description} />
            </div>
          )}
          {service.inclusions && service.inclusions.length > 0 && (
            <ul class="service-inclusions" role="list">
              {service.inclusions.map((item: string) => (
                <li class="inclusion-item">
                  <span class="inclusion-check" aria-hidden="true">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          )}
          {service.ctaLabel && service.ctaUrl && (
            <a href={service.ctaUrl} class="btn btn-primary service-cta">
              {service.ctaLabel}
            </a>
          )}
        </article>
      ))}
    </div>

    {secondary.length > 0 && (
      <div class="secondary-services-section">
        <h2 class="secondary-heading">One-time & migration options</h2>
        <div class="secondary-grid">
          {secondary.map(service => (
            <article class="secondary-card">
              <span class="service-tier">{service.tier}</span>
              <h3 class="service-name">{service.name}</h3>
              {service.tagline && <p class="service-tagline">{service.tagline}</p>}
              <p class="service-price">{service.price}</p>
              {service.ctaLabel && service.ctaUrl && (
                <a href={service.ctaUrl} class="btn btn-secondary secondary-cta">
                  {service.ctaLabel}
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .primary-services {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .primary-services {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    background: white;
    border: 1px solid rgba(30, 39, 48, 0.1);
    border-radius: 8px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .service-card-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .service-tier {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .service-name {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    color: var(--color-text-dark);
  }

  .service-tagline {
    font-size: 0.9375rem;
    color: var(--color-text-dark);
    opacity: 0.75;
    line-height: 1.5;
  }

  .service-pricing {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .service-price {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-dark);
  }

  .service-setup {
    font-size: 0.875rem;
    color: var(--color-text-dark);
    opacity: 0.6;
  }

  .service-desc {
    color: var(--color-text-dark);
    font-size: 0.9375rem;
  }

  .service-inclusions {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .inclusion-item {
    display: flex;
    gap: 0.625rem;
    font-size: 0.9rem;
    color: var(--color-text-dark);
    opacity: 0.85;
  }

  .inclusion-check {
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
  }

  .service-cta {
    align-self: flex-start;
    margin-top: auto;
  }

  .secondary-services-section {
    border-top: 1px solid rgba(30, 39, 48, 0.1);
    padding-top: 3rem;
  }

  .secondary-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--color-text-dark);
    margin-bottom: 1.5rem;
  }

  .secondary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .secondary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .secondary-card {
    background: white;
    border: 1px solid rgba(30, 39, 48, 0.1);
    border-radius: 8px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .secondary-cta {
    align-self: flex-start;
    margin-top: 0.5rem;
  }
</style>
