---
// No server-side props — this is a fully client-side component
const gauges = [
  { id: 'performance', label: 'Performance' },
  { id: 'accessibility', label: 'Accessibility' },
  { id: 'best-practices', label: 'Best Practices' },
  { id: 'seo', label: 'SEO' },
];

// SVG ring geometry: r=34 → circumference ≈ 213.63
const RADIUS = 34;
const CIRC = 2 * Math.PI * RADIUS;
---

<section class="psi-section surface-slate">
  <div class="container psi-pad">
    <div class="psi-inner">
      <div class="psi-header">
        <p class="eyebrow">Proof, not promises</p>
        <h2 class="psi-title">How fast is your site?</h2>
        <p class="psi-subtitle">Enter your URL to get a free Google PageSpeed score.</p>
      </div>

      <form class="psi-form" id="psi-form" novalidate>
        <div class="psi-input-row">
          <label for="psi-url" class="sr-only">Your website URL</label>
          <input
            type="url"
            id="psi-url"
            class="psi-input"
            placeholder="https://yoursite.com"
            autocomplete="url"
            required
          />
          <button type="submit" class="btn btn-primary psi-submit" id="psi-btn">
            See My Score
          </button>
        </div>
        <p class="psi-error" id="psi-error" role="alert" hidden></p>
      </form>

      <div class="psi-result" id="psi-result" hidden>
        <div class="psi-gauges">
          {gauges.map((g) => (
            <div class="gauge" id={`gauge-${g.id}`}>
              <div class="gauge-ring">
                <svg width="84" height="84" viewBox="0 0 84 84" aria-hidden="true">
                  <circle class="gauge-track" cx="42" cy="42" r={RADIUS} fill="none" stroke-width="5" />
                  <circle
                    class="gauge-fill"
                    cx="42"
                    cy="42"
                    r={RADIUS}
                    fill="none"
                    stroke-width="5"
                    stroke-linecap="round"
                    stroke-dasharray={CIRC}
                    stroke-dashoffset={CIRC}
                  />
                </svg>
                <span class="gauge-number">--</span>
              </div>
              <span class="gauge-label">{g.label}</span>
            </div>
          ))}
        </div>
        <p class="psi-result-url" id="psi-result-url"></p>
        <a href="/contact" class="btn btn-secondary psi-cta">
          Tell me why — show me how to fix it
        </a>
      </div>

      <div class="psi-loading" id="psi-loading" hidden>
        <div class="psi-spinner" aria-label="Loading your PageSpeed score…" role="status">
          <span class="sr-only">Loading…</span>
        </div>
        <p class="psi-loading-text">Checking your site…</p>
      </div>
    </div>
  </div>
</section>

<style>
  .psi-pad {
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .psi-inner {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .psi-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .psi-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    color: var(--text-on-dark);
  }

  .psi-subtitle {
    color: var(--text-on-dark);
    opacity: 0.75;
    font-size: var(--fs-body);
  }

  .psi-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .psi-input-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 520px) {
    .psi-input-row {
      flex-direction: row;
    }
  }

  .psi-input {
    flex: 1;
    padding: 0.75rem 1rem;
    background-color: var(--field-fill);
    border: 1px solid var(--border-input);
    border-radius: var(--radius-sm);
    color: var(--text-on-dark);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: var(--fw-body);
    transition: border-color var(--transition) var(--ease);
  }

  .psi-input::placeholder {
    color: var(--text-on-dark);
    opacity: 0.35;
  }

  .psi-input:focus {
    outline: none;
    border-color: var(--teal);
  }

  .psi-submit {
    flex-shrink: 0;
  }

  .psi-error {
    font-size: 0.875rem;
    color: var(--status-critical);
  }

  /* Result card — outline card on dark */
  .psi-result {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: transparent;
    border: 1px solid var(--border-on-dark);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .psi-gauges {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .gauge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .gauge-ring {
    position: relative;
    width: 84px;
    height: 84px;
  }

  .gauge-ring svg {
    transform: rotate(-90deg);
  }

  .gauge-track {
    stroke: color-mix(in srgb, var(--teal) 18%, transparent);
  }

  .gauge-fill {
    stroke: var(--status-good);
    transition: stroke-dashoffset 600ms var(--ease-out);
  }

  .gauge[data-rating='warn'] .gauge-fill {
    stroke: var(--status-warn);
  }

  .gauge[data-rating='critical'] .gauge-fill {
    stroke: var(--status-critical);
  }

  .gauge-number {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: var(--fw-display);
    font-size: 24px;
    color: var(--text-on-dark);
  }

  .gauge-label {
    font-size: var(--fs-caption);
    color: var(--text-on-dark-muted);
  }

  .psi-result-url {
    font-size: 0.875rem;
    color: var(--text-on-dark-muted);
    word-break: break-all;
  }

  .psi-cta {
    align-self: flex-start;
    font-size: 0.9rem;
  }

  /* Loading */
  .psi-loading {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .psi-spinner {
    width: 28px;
    height: 28px;
    border: 3px solid color-mix(in srgb, var(--teal) 25%, transparent);
    border-top-color: var(--accent);
    border-radius: var(--radius-full);
    animation: spin 0.8s linear infinite;
  }

  .psi-loading-text {
    color: var(--text-on-dark);
    opacity: 0.7;
    font-size: 0.9375rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  const form = document.getElementById('psi-form') as HTMLFormElement | null;
  const input = document.getElementById('psi-url') as HTMLInputElement | null;
  const btn = document.getElementById('psi-btn') as HTMLButtonElement | null;
  const resultEl = document.getElementById('psi-result');
  const loadingEl = document.getElementById('psi-loading');
  const errorEl = document.getElementById('psi-error');
  const resultUrlEl = document.getElementById('psi-result-url');

  const RADIUS = 34;
  const CIRC = 2 * Math.PI * RADIUS;

  const CATEGORIES: Array<{ id: string; key: string }> = [
    { id: 'performance', key: 'performance' },
    { id: 'accessibility', key: 'accessibility' },
    { id: 'best-practices', key: 'best-practices' },
    { id: 'seo', key: 'seo' },
  ];

  function setLoading(loading: boolean) {
    if (!btn || !loadingEl || !resultEl) return;
    btn.disabled = loading;
    if (loading) {
      loadingEl.hidden = false;
      resultEl.hidden = true;
      if (errorEl) errorEl.hidden = true;
    } else {
      loadingEl.hidden = true;
    }
  }

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.hidden = false;
  }

  function getRating(score: number): string {
    if (score >= 90) return 'good';
    if (score >= 50) return 'warn';
    return 'critical';
  }

  function setGauge(id: string, score: number) {
    const gauge = document.getElementById(`gauge-${id}`);
    if (!gauge) return;
    gauge.setAttribute('data-rating', getRating(score));
    const number = gauge.querySelector('.gauge-number');
    if (number) number.textContent = String(score);
    const fill = gauge.querySelector('.gauge-fill') as SVGCircleElement | null;
    if (fill) fill.style.strokeDashoffset = String(CIRC * (1 - score / 100));
  }

  if (form && input) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const raw = input.value.trim();
      if (!raw) {
        showError('Please enter a URL.');
        return;
      }

      let url = raw;
      if (!/^https?:\/\//i.test(url)) {
        url = 'https://' + url;
      }

      try {
        new URL(url);
      } catch {
        showError('That doesn\'t look like a valid URL. Try https://yoursite.com');
        return;
      }

      setLoading(true);

      try {
        const categoryParams = '&category=PERFORMANCE&category=ACCESSIBILITY&category=BEST_PRACTICES&category=SEO';
        const apiUrl = `https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url=${encodeURIComponent(url)}&strategy=mobile${categoryParams}`;
        const res = await fetch(apiUrl);
        if (!res.ok) {
          throw new Error(`PageSpeed API returned ${res.status}`);
        }
        const data = await res.json();
        const categories = data?.lighthouseResult?.categories ?? {};

        for (const { id, key } of CATEGORIES) {
          const score = Math.round((categories?.[key]?.score ?? 0) * 100);
          setGauge(id, score);
        }

        if (resultUrlEl) resultUrlEl.textContent = `${url} · measured on mobile`;
        if (resultEl) resultEl.hidden = false;
      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        showError(`Couldn't fetch your score — ${msg}. Try again or check your URL.`);
      } finally {
        setLoading(false);
      }
    });
  }
</script>
