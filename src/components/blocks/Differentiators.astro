---
interface DiffItem {
  headline: string;
  body: string;
}

interface Props {
  items?: DiffItem[];
}

const { items = [] } = Astro.props;
---

<section class="diffs topo-bg">
  <div class="container section">
    <div class="diffs-grid">
      {items.map((item: DiffItem) => (
        <div class="diff-item">
          <h3 class="diff-headline">{item.headline}</h3>
          <p class="diff-body">{item.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .diffs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .diffs-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .diff-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .diff-headline {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-accent);
    line-height: 1.2;
  }

  .diff-body {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    opacity: 0.85;
    line-height: 1.65;
  }
</style>
