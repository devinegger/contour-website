---
interface Row {
  label: string;
  competitorCost: string;
  contourCost: string;
}

interface Props {
  headline: string;
  intro?: string;
  rows?: Row[];
}

const { headline, intro, rows = [] } = Astro.props;
---

<section class="comparison topo-bg">
  <div class="container section">
    <div class="comparison-header">
      <h2 class="comparison-headline">{headline}</h2>
      {intro && <p class="comparison-intro">{intro}</p>}
    </div>
    <div class="table-wrapper" role="region" aria-label="Cost comparison table" tabindex="0">
      <table class="comparison-table">
        <thead>
          <tr>
            <th scope="col" class="col-label">Item</th>
            <th scope="col" class="col-competitor">Typical Agency Stack</th>
            <th scope="col" class="col-contour">Contour</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row: Row) => (
            <tr>
              <td class="cell-label">{row.label}</td>
              <td class="cell-competitor">{row.competitorCost}</td>
              <td class="cell-contour">{row.contourCost}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .comparison-header {
    margin-bottom: 2.5rem;
  }

  .comparison-headline {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .comparison-intro {
    color: var(--color-text);
    opacity: 0.8;
    font-size: 1.0625rem;
    max-width: 60ch;
    line-height: 1.6;
  }

  .table-wrapper {
    overflow-x: auto;
    border-radius: 8px;
    border: 1px solid rgba(74, 140, 140, 0.2);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  thead {
    background-color: rgba(74, 140, 140, 0.1);
  }

  th {
    padding: 1rem 1.25rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-text);
    opacity: 0.8;
    white-space: nowrap;
  }

  td {
    padding: 0.875rem 1.25rem;
    border-top: 1px solid rgba(245, 240, 235, 0.08);
    color: var(--color-text);
    opacity: 0.85;
  }

  .col-contour,
  .cell-contour {
    color: var(--color-accent);
    font-weight: 600;
    opacity: 1;
  }

  .cell-contour {
    color: var(--color-accent);
  }

  tr:hover td {
    background-color: rgba(74, 140, 140, 0.04);
  }
</style>
