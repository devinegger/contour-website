---
interface Row {
  label: string;
  competitorCost: string;
  contourCost: string;
}

interface Props {
  headline: string;
  intro?: string;
  rows?: Row[];
}

const { headline, intro, rows = [] } = Astro.props;
const isTotal = (row: Row) => row.label.trim().toLowerCase() === 'total';
---

<section class="comparison topo-bg">
  <div class="container section">
    <div class="comparison-header">
      <p class="eyebrow">The honest math</p>
      <h2 class="comparison-headline">{headline}</h2>
      {intro && <p class="comparison-intro">{intro}</p>}
    </div>
    <div class="table-wrapper" role="region" aria-label="Cost comparison table" tabindex="0">
      <table class="comparison-table">
        <thead>
          <tr>
            <th scope="col" class="col-label">Item</th>
            <th scope="col" class="col-competitor">Typical Agency Stack</th>
            <th scope="col" class="col-contour">Contour</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row: Row) => (
            <tr class={isTotal(row) ? 'row-total' : ''}>
              <td class="cell-label">{row.label}</td>
              <td class="cell-competitor">{row.competitorCost}</td>
              <td class="cell-contour">{row.contourCost}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .comparison-header {
    margin-bottom: 2.5rem;
  }

  .comparison-headline {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    color: var(--text-on-dark);
    margin: 0.5rem 0 0.75rem;
  }

  .comparison-intro {
    color: var(--text-on-dark);
    opacity: 0.8;
    font-size: 1.0625rem;
    max-width: 60ch;
    line-height: 1.6;
  }

  .table-wrapper {
    overflow-x: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-on-dark);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  thead {
    background-color: color-mix(in srgb, var(--teal) 10%, transparent);
  }

  th {
    padding: 1rem 1.25rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    opacity: 0.85;
    white-space: nowrap;
  }

  td {
    padding: 0.875rem 1.25rem;
    border-top: 1px solid var(--border-on-dark-hairline);
    color: var(--text-on-dark);
  }

  .cell-competitor {
    opacity: 0.85;
  }

  .col-contour,
  .cell-contour {
    color: var(--accent);
    font-weight: 600;
    opacity: 1;
  }

  .row-total td {
    font-weight: 700;
    font-family: var(--font-heading);
    border-top: 1px solid var(--border-on-dark-strong);
  }

  tr:hover td {
    background-color: color-mix(in srgb, var(--teal) 4%, transparent);
  }
</style>
