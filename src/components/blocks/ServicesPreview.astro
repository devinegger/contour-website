---
import { getServices } from '../../lib/data';

const servicesResult = await getServices();
const allServices = servicesResult?.data?.servicesConnection?.edges ?? [];
const tiers = ['baseline', 'elevated', 'crest'];
const services = allServices
  .map((e: { node: unknown }) => e.node)
  .filter((s: { tier?: string }) => tiers.includes(s.tier ?? ''));
---

<section class="services-preview topo-bg-light">
  <div class="container section">
    <p class="eyebrow">Plans</p>
    <h2 class="preview-heading">Simple, clear plans</h2>
    <p class="preview-intro">Pick the tier that fits where you are. Move up as you grow.</p>
    <div class="preview-cards">
      {services.map((service: {
        name: string;
        slug: string;
        tier: string;
        tagline?: string;
        price?: string;
      }) => (
        <article class="preview-card">
          <span class="card-tier">{service.tier}</span>
          <h3 class="card-name">{service.name}</h3>
          {service.tagline && <p class="card-tagline">{service.tagline}</p>}
          {service.price && <p class="card-price">{service.price}</p>}
          <a href="/services" class="card-cta btn btn-secondary btn-sm">
            Learn more
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .preview-heading {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    color: var(--text-on-light);
    margin: 0.5rem 0 0.25rem;
  }

  .preview-intro {
    color: var(--text-on-light-muted);
    margin-bottom: 2.5rem;
    font-size: 1.0625rem;
  }

  .preview-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  @media (min-width: 800px) {
    .preview-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .preview-card {
    background: var(--surface-card-light);
    border: 1px solid var(--border-on-light);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: box-shadow var(--transition) var(--ease);
  }

  .preview-card:hover {
    box-shadow: var(--shadow-card);
  }

  .card-tier {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    color: var(--accent);
    line-height: 1;
  }

  .card-name {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    color: var(--text-on-light);
  }

  .card-tagline {
    font-size: 0.9375rem;
    color: var(--text-on-light-muted);
    line-height: 1.5;
    flex: 1;
  }

  .card-price {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: var(--fw-heading);
    color: var(--text-on-light);
  }

  .card-cta {
    align-self: flex-start;
    margin-top: 0.5rem;
  }
</style>
