---
interface Props {
  statement: string;
  badgeSlot?: string;
}

const { statement, badgeSlot } = Astro.props;
---

<section class="trust topo-bg">
  <div class="container trust-section">
    <div class="trust-inner">
      <p class="trust-statement">{statement}</p>
      {badgeSlot && (
        <div class="trust-badge">
          <img src={badgeSlot} alt="Trust badge" width="120" height="60" />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .trust-section {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .trust-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .trust-statement {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.5vw, 1.7rem);
    font-weight: var(--fw-ui);
    font-style: italic;
    color: var(--text-on-dark);
    max-width: 58ch;
    line-height: 1.5;
    opacity: 0.9;
  }

  .trust-badge img {
    display: block;
    opacity: 0.8;
  }
</style>
