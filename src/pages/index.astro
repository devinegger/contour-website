---
export const prerender = true;
import Layout from '../components/layout/Layout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Blocks from '../components/blocks/Blocks.astro';
import { islands } from '../lib/islands';
import { getPage, getSiteSettings } from '../lib/data';
import { localBusinessSchema, webSiteSchema } from '../lib/schema';

const slug = 'home';
const pageResult = await getPage(slug);
const settingsResult = await getSiteSettings();
const page = pageResult?.data?.pages;
const settings = settingsResult?.data?.siteSettings;

const schemas = [localBusinessSchema(settings), webSiteSchema(settings)];
---

<Layout
  title={page?.seo?.metaTitle ?? settings?.defaultSeoTitle ?? 'Contour'}
  description={page?.seo?.metaDescription ?? settings?.defaultSeoDescription ?? ''}
  ogImage={page?.seo?.ogImage ?? settings?.defaultOgImage ?? ''}
  schemas={schemas}
>
  <TinaIsland name="page" wrapper={islands.page.wrapper} params={{ slug }} primary>
    <Blocks page={page} />
  </TinaIsland>
</Layout>
