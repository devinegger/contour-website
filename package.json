{
  "name": "contour-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "tinacms build --local --skip-cloud-checks -c \"astro build\"",
    "build:cloud": "tinacms build && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@tinacms/astro": "^0.4.0",
    "@tinacms/cli": "^2.4.3",
    "astro": "^6.4.4",
    "tinacms": "^3.9.0"
  },
  "pnpm": {
    "allowedBuilds": {
      "esbuild": true,
      "sharp": true,
      "better-sqlite3": true
    }
  }
}
