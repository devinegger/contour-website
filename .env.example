# Copy to .env and fill in. .env is gitignored.

# TinaCloud — admin auth + content API (creds from app.tina.io)
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Cloudflare image resizing.
# When "true", uploaded images (/uploads/*) are served through Cloudflare's
# /cdn-cgi/image/ transformation endpoint (resize + compress + AVIF/WebP).
# Leave unset/false locally: /cdn-cgi/image/ only exists on the Cloudflare
# edge with Image Resizing enabled on the zone, so off = serve originals.
# Set to "true" in the production (Cloudflare) build environment once
# resizing is live on the zone.
PUBLIC_IMAGE_RESIZING=false
